{
  "name": "@jezumbro/github-action-notion",
  "description": "Output all pages into folder for github pages.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node __tests__/index.test.js",
    "format": "npm run prettier && npm run lint",
    "format:ci": "npm run prettier:ci && npm run lint:ci",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "prettier": "prettier --write .",
    "prettier:ci": "prettier --check .",
    "test": "vitest",
    "test:ci": "vitest run",
    "prepare": "husky",
    "publish": "ncc build -m --license licenses.txt"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jezumbro/github-action-notion.git"
  },
  "keywords": [
    "actions",
    "notion",
    "astro"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@notionhq/client": "^5.4.0",
    "change-case": "^5.4.4",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.2",
    "notion-to-md": "^3.1.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "vitest": "^4.0.13"
  },
  "version": "1.1.1"
}
